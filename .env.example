# GLM-5.3-Flash EXL3 + DFlash2 on 2x DGX Spark — install/serve configuration.
# install.sh copies this to .env on first run; edit .env, not this file.
# Values here become each box's ~/.glm53-serve.env; command-line env always
# overrides. Serving knobs are forwarded ONLY if you set them here — leave
# them commented out to track the launcher's validated defaults.

# --- required: the two boxes -------------------------------------------------
# LAN address install.sh uses to reach the worker over SSH (passwordless
# head->worker SSH is required).
WORKER_LAN_IP=192.168.1.2
WORKER_USER=              # empty = same user as on the head

# The direct 200GbE link between the two Sparks (QSFP/CX7). These are the
# addresses NCCL and vLLM rendezvous on — NOT the LAN addresses.
HEAD_RAIL_IP=10.200.0.1
WORKER_RAIL_IP=10.200.0.2
# Rail interface + RoCE HCA names, per box (ip -o addr / ibv_devices).
HEAD_NCCL_IF=enp1s0f0np0
HEAD_NCCL_HCA=rocep1s0f0
WORKER_NCCL_IF=enp1s0f0np0
WORKER_NCCL_HCA=rocep1s0f0
NCCL_SUBNET=10.200.0.0/24

# --- weights -----------------------------------------------------------------
# local (default): EXL3 weights on BOTH boxes (~176 GiB each). Simplest.
#   The default direct-I/O loader (LOAD_FORMAT=instanttensor) keeps the
#   load off swap entirely (~3.6 min to API). If you opt back into the
#   page-cached loader (LOAD_FORMAT= empty): weight load consumes ALL
#   available swap in BOTH modes (measured 2026-08-31: full 32 GiB used,
#   0.8 GiB MemFree floor) and stock 16 GiB swap OOMs the head at ~90%
#   of shard load — grow swap to >=32 GiB on both boxes first. --nfs
#   does NOT pace the load on a fast rail.
# nfs: weights only on the worker (the validated-production topology of the
#   reference kit); the worker exports them via a containerized NFS server
#   and the head mounts a docker NFS volume. Head then needs ~20 GiB disk.
WEIGHTS_MODE=local
MODEL_HOST_PATH=          # empty = $HOME/models/glm53-exl3
DFLASH_DIR=               # empty = $HOME/models/glm53-dflash2
EXL3_REPO=brandonmusic/GLM-5.3-Flash-tr3-4bpw
EXL3_REPO_FALLBACK=Mia-AiLab/GLM-5.3-Flash-EXL3-TR3-4bpw
# DFlash2 drafter is CC BY-NC-ND 4.0 (research/eval): always downloaded from
# its source repo, never redistributed by this project.
DFLASH_REPO=incoai/GLM-5.3-Flash-DFlash2
# --nfs mode export server image. Default: the kit's own minimal NFSv4-only
# image (nfs/), built natively ON the worker at install time — published NFS
# server images are amd64-only and crash-loop on aarch64 (issue #1). Set to
# a prebuilt image to skip the build.
#NFS_IMAGE=glm53-nfs-server:kit

# --- image -------------------------------------------------------------------
IMAGE=ghcr.io/entrpi/glm-5.3-flash-exl3-2x-spark:v2-glmnext

# --- serving knobs (defaults = the validated production configuration) -------
# See scripts/launch-glm53-vllm-tp2.sh for per-knob rationale + failure modes.
#MAX_LEN=524288           # 500k default bank; 131072 = short-context mode
#SPEC=dflash              # none to disable speculation; MTP=4 for the fallback
#EAGER=0                  # 1 = --enforce-eager (slower; for debugging)
#SKIP_MM_PROFILING=1      # 0 restores the max-size MM profile (short MAX_LEN)
#BLOCK_SIZE=2304          # auto-bumps to 4608 with fp8 KV (page parity)
#KV_DTYPE=fp8_ds_mla      # default (GLM_NEXT lane): 1,324,163-token pool
                          # @524k; fp8_e4m3 = the 2026-08-29 lane (1,435,070);
                          # empty = bf16 (pair with MAX_LEN=131072)
#LOAD_FORMAT=instanttensor # DEFAULT since 2026-08-31: safetensors load via
                          # pipelined-prefetch direct I/O, bypassing the page
                          # cache — no swap consumption, ~3.6 min to API,
                          # keeps CUDA graphs + the fused EXL3 path; expect
                          # ~10-15 min of mildly noisy TTFT post-boot while
                          # load-era pages fault back in. Explicitly EMPTY
                          # (LOAD_FORMAT=) restores the page-cached loader
                          # (needs the >=32 GiB swap prerequisite above).
                          # Recipe by @Marker689 (#2).
# --- GLM_NEXT b12x lane (ratified 2026-08-30) is the LAUNCHER DEFAULT with
# --- the v2-glmnext image — these three knobs are only needed to pin them
# --- explicitly, or on the older v1-dflash2 image (which also needs the
# --- hotfix overlays for the lane). See docs/FINDINGS.md §12.
#ATTN_BACKEND=B12X_MLA_SPARSE
#KV_DTYPE=fp8_ds_mla       # 528 B/token packed records; 1,324,163-token pool
#KV_SKIP_LAYERS=sliding_window  # DFlash2 draft ring-KV runs bf16
#KV_CACHE_MEMORY=         # empty -> 12.4e9 validated; auto -> vLLM budgeting
#MNBT=8192
#GMU=0.85                 # 0.88+ risks unified-memory swap on GB10
#PORT=8000
# --- Mixed-prefill decode floor (FINDINGS §15). Off by default. -1 skips
# --- peer prefill chunks while anything is decoding (decode p50 during a
# --- 133k prefill: 1.4 -> 11.4 tok/s for 1.40x its TTFT); N>0 caps them
# --- to N tokens (measured strictly worse than skip on this stack). Solo
# --- prefills are never affected. MAX_DEFER bounds consecutive deferrals
# --- before one unrestricted step (anti-starvation; default 8).
#MIXED_PREFILL_CAP=-1
#MIXED_PREFILL_MAX_DEFER=8
# --- NVFP4 KV profile (FINDINGS §13): rope-less 304 B/token records,
# --- dynamic per-token scales (no calibration file). +28.6% pool
# --- (1,702,584 tokens = 3.25 × 524k banks); quality between the two
# --- fp8 lanes. Set on TOP of the GLM_NEXT trio above.
#KV_DTYPE=nvfp4_ds_mla
#VLLM_NVFP4_MLA_DYNAMIC_SCALE=1
# --- Native 1M profile (FINDINGS §13): 2.05 concurrent 1M banks on the
# --- NVFP4 lane. ~15 min per cold 1M prefill; MNBT=4096 keeps the
# --- head-box memory floor safe. On the v1-dflash2 image also build
# --- topk_fix.so (persistent_topk full-smem retry) and point at it.
#MAX_LEN=1048576
#MNBT=4096
#GLM53_TOPK_FIX_SO=/cache/topk_fix.so
