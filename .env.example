# GLM-5.3-Flash EXL3 + DFlash2 on 2x DGX Spark — install/serve configuration.
# install.sh copies this to .env on first run; edit .env, not this file.
# Values here become each box's ~/.glm53-serve.env; command-line env always
# overrides. Serving knobs are forwarded ONLY if you set them here — leave
# them commented out to track the launcher's validated defaults.

# --- required: the two boxes -------------------------------------------------
# LAN address install.sh uses to reach the worker over SSH (passwordless
# head->worker SSH is required).
WORKER_LAN_IP=192.168.1.2
WORKER_USER=              # empty = same user as on the head

# The direct 200GbE link between the two Sparks (QSFP/CX7). These are the
# addresses NCCL and vLLM rendezvous on — NOT the LAN addresses.
HEAD_RAIL_IP=10.200.0.1
WORKER_RAIL_IP=10.200.0.2
# Rail interface + RoCE HCA names, per box (ip -o addr / ibv_devices).
HEAD_NCCL_IF=enp1s0f0np0
HEAD_NCCL_HCA=rocep1s0f0
WORKER_NCCL_IF=enp1s0f0np0
WORKER_NCCL_HCA=rocep1s0f0
NCCL_SUBNET=10.200.0.0/24

# --- weights -----------------------------------------------------------------
# local (default): EXL3 weights on BOTH boxes (~176 GiB each). Simplest.
#   The default direct-I/O loader (LOAD_FORMAT=instanttensor) keeps the
#   load off swap entirely (~3.6 min to API). If you opt back into the
#   page-cached loader (LOAD_FORMAT= empty), weight load consumes all
#   available swap in both modes and stock 16 GiB swap kills the head at
#   ~90% of the load — grow swap to >= 32 GiB on both boxes first. --nfs
#   does not pace the load on a fast rail.
# nfs: weights only on the worker (the validated-production topology of the
#   reference kit); the worker exports them via a containerized NFS server
#   and the head mounts a docker NFS volume. Head then needs ~20 GiB disk.
WEIGHTS_MODE=local
MODEL_HOST_PATH=          # empty = $HOME/models/glm53-exl3
DFLASH_DIR=               # empty = $HOME/models/glm53-dflash2-mxfp8
# The drafter (DFlash2 by IncoAI) is CC BY-NC-ND 4.0 (research/eval): always
# downloaded from its source, never redistributed here. Default is the MXFP8
# copy published by local-inference-lab (1.3 GiB; validated at acceptance
# parity with the bf16 original, 3-5 ms/step faster). For the bf16 original:
#   DFLASH_REPO=incoai/GLM-5.3-Flash-DFlash2  DFLASH_DIR=$HOME/models/glm53-dflash2
DFLASH_REPO=local-inference-lab/GLM-5.3-Flash-DFlash2-MXFP8
#DFLASH_REVISION=          # repo commit to fetch; default pins the validated one for the default repo
# --nfs mode export server image. Default: the kit's own minimal NFSv4-only
# image (nfs/), built natively ON the worker at install time — published NFS
# server images are amd64-only and crash-loop on aarch64 (issue #1). Set to
# a prebuilt image to skip the build.
#NFS_IMAGE=glm53-nfs-server:kit

# --- image -------------------------------------------------------------------
# Leave IMAGE unset to run the release this kit was tested with (the launcher's
# default). Pinning an OLDER tag is not supported by the current launcher
# defaults: v1-dflash2 / v2-glmnext predate fine-grained prefix reuse and the
# 14.4 GB KV budget and assert on the first request; the launcher refuses
# that combination.
#IMAGE=ghcr.io/entrpi/glm-5.3-flash-exl3-2x-spark:v2.3-tier1

# --- serving knobs ----------------------------------------------------------
# Commented values are the validated defaults. Set a knob only to change it;
# scripts/launch-glm53-vllm-tp2.sh documents each one's failure modes. The
# README's "Choosing a configuration" table maps workloads to these knobs.
#MAX_LEN=524288           # longest request accepted (tokens); 1048576 = native 1M profile
#MAX_SEQS=4               # requests served at once (12-16 for the agentic profile)
#MNBT=8192                # prompt tokens processed per step while reading a document
                          # (4096 keeps live chats smoother and is required at 1M)
#SPEC=dflash              # speculative drafter on; none = off (fastest at >= 8 streams;
                          # the 1.3 GB drafter stays unloaded and the pool grows +44%)
#MTP=0                    # 4 = the model's built-in multi-token head instead (fallback,
                          # ~20% slower decode; drafter not loaded)
#KV_DTYPE=fp8_ds_mla      # attention-memory format: fp8_ds_mla (default),
                          # nvfp4_ds_mla (+29% capacity, small quality step),
                          # empty = unquantized (pair with MAX_LEN=131072)
#VLLM_NVFP4_MLA_DYNAMIC_SCALE=1   # required with KV_DTYPE=nvfp4_ds_mla
#KV_CACHE_MEMORY=         # empty -> 14.4e9: validated on lightly loaded headless
                          # boxes (< 6 GB system memory in use before launch);
                          # lower it if other services or a desktop are resident
                          # (~90k pool tokens per GB)
#GMU=0.85                 # GPU memory fraction; 0.88+ risks unified-memory swap
#MEM_USED_MAX_GB=6        # launch preflight: refuse if more system memory is in use; 0 disables
#MIXED_PREFILL_DECODE_WEIGHT=1.0  # with MIXED_PREFILL_CAP=512: live chats keep
#MIXED_PREFILL_CAP=512             # 85-91% of their speed while documents load
#LOAD_FORMAT=instanttensor # direct-I/O weight loader (default, ~3.6 min to API;
                          # empty = page-cached loader, needs >= 32 GiB swap)
#EAGER=0                  # 1 = no CUDA graphs (slower; debugging only)
#SKIP_MM_PROFILING=1      # 0 restores the image-input profile pass (short MAX_LEN only)
#BLOCK_SIZE=2304          # KV page; auto-bumps to 4608 with fp8 attention memory
#PREFIX_MATCH_UNIT=512    # prefix-reuse granularity in tokens (empty = whole 4608-token pages)
#PORT=8000
# --- drafter-step knobs (v2.3 defaults; set to 0 to switch off) ---------------
#VLLM_USE_B12X_FP8_GEMM=1        # b12x GEMM for the drafter (set 0 on pre-v2.3 images)
#VLLM_B12X_MXFP8_MAX_M=16        # rows above this use the FlashInfer kernel
#VLLM_DFLASH_FP8_DRAFT_HEAD=1    # fp8 draft head (-1 ms/step, +317 MB per rank)
#NCCL_NCHANNELS=8                # NCCL channels for the two-box all-reduce (0 = let NCCL choose)
#GLM53_NO_UPDATE_CHECK=1         # 1 = never check the kit repository for a newer release at launch
# --- lane pins (already the launcher defaults; only for pinning explicitly) ---
#ATTN_BACKEND=B12X_MLA_SPARSE
#KV_SKIP_LAYERS=sliding_window
